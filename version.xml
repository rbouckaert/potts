<package name='PhyloPotts' version='0.0.1'>
	<depends on='BEAST.base' atleast='2.7.0'/>
	<depends on='BEAST.app' atleast='2.7.0'/>

<packageapp description="DCA trainer" class="potts.dca.TrainDCA" args=""/>
<packageapp description="DCASequenceSimulator" class="potts.dca.DCASequenceSimulator" args=""/>
            
        <service type="beast.base.core.BEASTInterface">
                <provider classname="potts.dca.DCASequenceSimulator"/>
                <provider classname="potts.dca.AnnealedImportanceSampling"/>
                <provider classname="potts.dca.TrainDCA"/>
                <provider classname="potts.dca.DCAFromFile"/>
                <provider classname="potts.dca.SimulatedDCAAlignment"/>
                
                <provider classname="potts.datatype.AminoacidPlus"/>
                <provider classname="potts.substitutionmodel.EmpiricalModelPlus"/>

                <provider classname="potts.likelihood.TreeLikelihoodWithRootStates"/>
                <provider classname="potts.likelihood.PottsSequenceLikelihood"/>
                
                <provider classname="potts.operator.RootSequenceResampler"/>
                <provider classname="potts.operator.RootHeightAndSequenceResampler"/>
                <provider classname="potts.operator.SimpleRootOperator"/>
    	</service>
            
</package>
